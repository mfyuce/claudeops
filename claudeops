  local p; p=$(find_self_claude_pid)
  if [ -z "$p" ]; then echo "(claude alt-süreci değilim — self yok)"; return 1; fi
  python3 -c "
import json
d = json.load(open('$SESS_DIR/$p.json'))
print('pid:        ', d['pid'])
print('sessionId:  ', d['sessionId'])
print('name:       ', d.get('name','-') or '-')
print('cwd:        ', d['cwd'])
print('status:     ', d.get('status',''))
print('bridge:     ', d.get('bridgeSessionId','-'))
