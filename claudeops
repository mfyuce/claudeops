# ─────────────────────────────────────────────
# CMD: snapshot — canlı fleet'i roster.tsv'ye dök (referans/boot --from-roster)
#   self HARİÇ. name<TAB>cwd<TAB>model. Fleet ayaktayken bir kez çalıştır.
# ─────────────────────────────────────────────
cmd_snapshot() {
  local rows n=0; rows=$(all_sessions_tsv | filter_not_self)
  local tmp="$ROSTER_FILE.tmp.$$"; : > "$tmp"
  while IFS=$'\t' read pid name status sid cwd bridge; do
    [ -z "$name" ] && continue
    local model; model=$(python3 -c "import json;print(json.load(open('$SESS_DIR/$pid.json')).get('model') or '')" 2>/dev/null)
    printf '%s\t%s\t%s\n' "$name" "$cwd" "$model" >> "$tmp"; n=$((n+1))
  done <<<"$rows"
  mkdir -p "$STATE_DIR" 2>/dev/null; mv "$tmp" "$ROSTER_FILE"
  echo "snapshot: $n session → $ROSTER_FILE"; [ "$n" -gt 0 ] && cat "$ROSTER_FILE"
}

# ─────────────────────────────────────────────
# CMD: boot [--lock] [--layout] [--from-roster] [--pace=N]
#   Cold-boot oto-açılış. Default kaynak: $BOOT_LIST (curated, co+mo). Akış:
#     1) X/WM hazır olana dek bekle (autostart erken tetiklenir, ~90s tolerans)
#     2) listedeki her session'ı doğru cwd + model/perm/effort ile aç (paced)
#     3) --layout ise tile;  --lock ise EN SON ekranı kilitle (fleet arkada çalışır)
#   Autologin + ~/.config/autostart/claudeops.desktop ile reboot'ta otomatik.
#   --from-roster: tam fleet'i (snapshot çıktısı) aç. Default sadece co+mo.
# ─────────────────────────────────────────────
BOOT_LIST="${BOOT_LIST:-$STATE_DIR/boot.list}"   # curated cold-boot set: name<TAB>cwd<TAB>model (env override edilebilir)
BOOT_MODEL_DEFAULT='claude-opus-4-8[1m]'
cmd_boot() {
  local do_lock=0 pace=2 src="$BOOT_LIST" perm="auto" effort="max" do_layout=0 app_id=""
  for a in "$@"; do case "$a" in
    --lock) do_lock=1;;
    --no-lock) do_lock=0;;
    --layout) do_layout=1;;
    --from-roster) src="$ROSTER_FILE";;
    --pace=*) pace="${a#--pace=}";;
    --permission-mode=*) perm="${a#--permission-mode=}";;
    --effort=*) effort="${a#--effort=}";;
    --app-id=*) app_id="${a#--app-id=}";;
    -h|--help) echo "claudeops boot [--lock] [--layout] [--from-roster] [--pace=N]"; echo "  $BOOT_LIST (default co+mo) içindeki session'ları açar; --lock ile en son kilitler."; return 0;;
  esac; done
  [ -f "$src" ] || { echo "boot: liste yok ($src). Satır formatı:  co<TAB>/path<TAB>claude-opus-4-8[1m]"; return 1; }

  # 1) X/WM hazır mı? (autostart session başında, WM tam ayağa kalkmadan tetiklenebilir)
  local w=0
  while [ $w -lt 90 ]; do { [ -n "$DISPLAY" ] && wmctrl -m >/dev/null 2>&1; } && break; sleep 1; w=$((w+1)); done
  { [ -n "$DISPLAY" ] && wmctrl -m >/dev/null 2>&1; } || { echo "boot: X/WM hazır değil (${w}s bekledim) DISPLAY=${DISPLAY:-?}"; return 1; }

  # 2) listedeki session'ları paced aç (rapid burst gnome-terminal-server'ı wedge'ler).
  #    İsim = base + son-suffix (co30); sid bulunursa --resume → geçmiş korunur ("session bilgisi").
  local suffix; suffix=$(_suffix_get)
  local n=0
  while IFS=$'\t' read name cwd model; do
    case "$name" in ''|'#'*) continue;; esac
    [ -d "$cwd" ] || { echo "  SKIP $name: cwd yok ($cwd)"; continue; }
    local base; base=$(printf '%s' "$name" | sed -E 's/[0-9]+$//')
    local eff="${base}${suffix}"
    local m="${model:-$BOOT_MODEL_DEFAULT}"
    local sid; sid=$(_latest_sid_for_cwd "$cwd")
    local resume=""; [ -n "$sid" ] && resume="--resume $sid"
    gnome-terminal ${app_id:+--app-id="$app_id"} --window --title="$eff" --working-directory="$cwd" \
      -- bash -c "$SPAWN_ENV claude $resume --model '$m' --permission-mode '$perm' --effort '$effort' -n '$eff' --remote-control '$eff'; exec bash" &
    echo "  BOOT $eff ($cwd) $([ -n "$sid" ] && echo "resume=${sid:0:8}" || echo fresh) model=$m"
    n=$((n+1)); sleep "$pace"
  done < "$src"
  echo "boot: $n session açıldı (suffix=${suffix:-yok})"

  [ "$do_layout" = "1" ] && { sleep 5; cmd_layout grid 4 || true; }

  # 3) en son: ekranı kilitle — "autologin olur olmaz lock" (fleet arkada koşar, şifreyle aç)
  if [ "$do_lock" = "1" ]; then
    sleep 2
    loginctl lock-session 2>/dev/null \
      || dbus-send --session --type=method_call --dest=org.gnome.ScreenSaver \
           /org/gnome/ScreenSaver org.gnome.ScreenSaver.Lock 2>/dev/null
    echo "boot: ekran kilitlendi"
  fi
}

# ─────────────────────────────────────────────
# CMD: recover [--since=ISO] — reboot sonrası resume-edilebilir session'ları listele
#   jsonl transcript'ler reboot'tan sağ çıkar; her repo'nun EN GÜNCEL'i resume adayı.
#   Çıktı: cwd · sid (resume için) · git-dirty · son-aktif. READ-ONLY.
#   Resume: cd <cwd> && claude --resume <sid>   (veya boot otomatik yapar)
# ─────────────────────────────────────────────
cmd_recover() {
  local since="2026-01-01 00:00"
  for a in "$@"; do case "$a" in --since=*) since="${a#--since=}";; esac; done
  printf "%-46s %-38s %-5s %s\n" "CWD" "SID (resume)" "DIRTY" "son-aktif"
  find "$HOME/.claude/projects" -name '*.jsonl' -newermt "$since" -printf '%T@\t%p\n' 2>/dev/null \
   | sort -rn \
   | awk -F'\t' '{d=$2; if(!seen[$2]++){ c=$2; sub(/.*\/projects\//,"",c); sub(/\/[^/]*$/,"",c); if(!dir[c]++) print $2 }}' \
   | while read -r jf; do
       local sid cwd tm dirty
       sid=$(basename "$jf" .jsonl)
       cwd=$(grep -m1 -oE '"cwd":"[^"]*"' "$jf" 2>/dev/null | head -1 | sed 's/"cwd":"//;s/"$//')
       [ -z "$cwd" ] && continue
       tm=$(stat -c %y "$jf" 2>/dev/null | cut -d. -f1 | cut -d' ' -f2)
       if [ -d "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
         dirty=$( [ -n "$(git -C "$cwd" status --porcelain 2>/dev/null)" ] && echo YES || echo no )
       else dirty="?"; fi
       printf "%-46s %-38s %-5s %s\n" "$cwd" "$sid" "$dirty" "$tm"
     done
}

# ─────────────────────────────────────────────
# _detect_display: cron/autostart'ta DISPLAY/XAUTHORITY/DBUS env'i yoksa
#   çalışan GNOME oturum process'inden (gnome-shell > gnome-session > nautilus)
#   runtime'da çek + export. Display numarası reboot'ta değişse de tutar.
#   (cron'da DISPLAY=:0 hardcode kırılgandı; gerçek :1 olabiliyor.)
# ─────────────────────────────────────────────
_detect_display() {
  # Zaten çalışan WM varsa dokunma
  { [ -n "${DISPLAY:-}" ] && wmctrl -m >/dev/null 2>&1; } && return 0
  local p
  for comm in gnome-shell gnome-session-binary nautilus gnome-terminal-server; do
    p=$(pgrep -x "$comm" -U "$(id -u)" 2>/dev/null | head -1)
    [ -n "$p" ] && [ -r "/proc/$p/environ" ] || continue
    local d x b
    d=$(tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -m1 '^DISPLAY=' | cut -d= -f2-)
    x=$(tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -m1 '^XAUTHORITY=' | cut -d= -f2-)
    b=$(tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -m1 '^DBUS_SESSION_BUS_ADDRESS=' | cut -d= -f2-)
    [ -n "$d" ] || continue
    export DISPLAY="$d"
    [ -n "$x" ] && export XAUTHORITY="$x"
    [ -n "$b" ] && export DBUS_SESSION_BUS_ADDRESS="$b"
    wmctrl -m >/dev/null 2>&1 && return 0
  done
  return 1
}

# ─────────────────────────────────────────────
# CMD: guard [--boot] [--lock] [--dry-run] [--pace=N]
#   Watchdog: models.tsv fleet'ini tara, kapananları yeniden aç.
#   Kaynak: models.tsv (name→model) + roster.tsv (name→cwd)
#   --boot: X/WM hazır olana kadar bekle (autostart .desktop için)
#   --lock: spawn sonrası ekranı kilitle
#   --dry-run: ne açılacağını göster, açma
#   Cron örneği: */2 * * * * DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus claudeops guard
# ─────────────────────────────────────────────
cmd_guard() {
  local dry=0 pace=2 perm="auto" effort="max" do_lock=0 boot_mode=0
  for a in "$@"; do case "$a" in
    --dry-run) dry=1;;
    --boot) boot_mode=1;;
    --lock) do_lock=1;;
    --pace=*) pace="${a#--pace=}";;
    -h|--help) echo "claudeops guard [--boot] [--lock] [--dry-run] [--pace=N]"; return 0;;
  esac; done

  # SERİLEŞTİR — flock: aynı anda iki guard (cron+manuel ya da yavaş-cron overlap) çalışırsa
  # ikisi de fleet'i 'down' görüp HEPSİNİ açar → her cwd'de duplicate session. Non-blocking:
  # kilit başka guard'daysa sessizce çık. fd 9 process exit'te kapanır → kilit serbest kalır.
  if [ "$dry" != "1" ]; then
    exec 9>"$LOG_DIR/guard.lock"
    if ! flock -n 9; then echo "[$(date '+%H:%M:%S')] guard: başka instance çalışıyor, atlandı"; return 0; fi
  fi

  local models_tsv="$STATE_DIR/models.tsv"
  [ -f "$models_tsv" ] || { echo "guard: models.tsv yok ($models_tsv)"; return 1; }
  [ -f "$ROSTER_FILE" ] || { echo "guard: roster.tsv yok ($ROSTER_FILE). 'claudeops snapshot' çalıştır."; return 1; }

  local suffix; suffix=$(_suffix_get)
  [ -z "$suffix" ] && { echo "guard: suffix state yok ($SUFFIX_FILE)"; return 1; }

  # X/WM kontrolü — env yoksa çalışan GNOME oturumundan DISPLAY/XAUTH/DBUS çek
  if [ "$boot_mode" = "1" ]; then
    local w=0
    while [ $w -lt 90 ]; do _detect_display && break; sleep 1; w=$((w+1)); done
    _detect_display || { echo "guard: X/WM hazır değil (${w}s beklendi)"; return 1; }
  else
    _detect_display || { echo "guard: DISPLAY/WM yok, atlanıyor"; return 0; }
  fi

  # Şu an çalışan session isimleri + cwd'leri (isim eşleşmese bile aynı cwd varsa atla)
  local running_tsv; running_tsv=$(all_sessions_tsv 2>/dev/null)
  local running; running=$(echo "$running_tsv" | awk -F'\t' '{print $2}')
  local running_cwds; running_cwds=$(echo "$running_tsv" | awk -F'\t' '{print $5}')

  local reopened=0 skipped=0 no_cwd=0
  mkdir -p /tmp/claudeops 2>/dev/null
  local ts; ts=$(date '+%H:%M:%S')

  while IFS=$'\t' read base model; do
    case "$base" in ''|'#'*) continue;; esac
    local expected="${base}${suffix}"

    # cwd — roster.tsv'den (isim kontrolünden önce lazım)
    local cwd; cwd=$(grep -P "^${base}\t" "$ROSTER_FILE" 2>/dev/null | cut -f2 | head -1)

    # Zaten çalışıyor? (isim VEYA aynı cwd — isim değişse de, ör. co29 vs co32)
    if echo "$running" | grep -qxF "$expected"; then
      skipped=$((skipped+1)); continue
    fi
    if [ -n "$cwd" ] && echo "$running_cwds" | grep -qxF "$cwd"; then
      skipped=$((skipped+1)); continue
    fi
    if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
      echo "  SKIP $expected: cwd yok (roster'da eksik: ${cwd:-?})"
      no_cwd=$((no_cwd+1)); continue
    fi

    # Crash-recovery semantiği (kullanıcı 2026-06-04): "önceki/son session'dan devam etmeli."
    # cwd'nin EN GÜNCEL jsonl'i = kullanıcının kaldığı konuşma → HER ZAMAN --resume et
    # (cmd_boot ile aynı davranış). Eski suffix-gate ('son ho sonrası iş varsa resume')
    # idle *33 + crash recovery'de fresh açıp çalışan context'i kaybettiriyordu — kaldırıldı.
    # Handover'ın 'fresh aç' niyeti ayrı komut (rc --new); guard sadece kurtarır.
    local sid; sid=$(_latest_sid_for_cwd "$cwd")
    local resume_arg="" resume_label="fresh"
    [ -n "$sid" ] && { resume_arg="--resume $sid"; resume_label="resume=${sid:0:8}"; }

    if [ "$dry" = "1" ]; then
      echo "  DRY  $expected ← $cwd $resume_label model=$model"
    else
      gnome-terminal --window --title="$expected" --working-directory="$cwd" \
        -- bash -c "$SPAWN_ENV claude $resume_arg --model '$model' --permission-mode '$perm' --effort '$effort' -n '$expected' --remote-control '$expected'; exec bash" &
      echo "[$ts] REOPEN $expected ← $resume_label ($cwd)"
      reopened=$((reopened+1))
      sleep "$pace"
    fi
  done < "$models_tsv"

  echo "[$ts] guard done: reopened=$reopened skipped=$skipped no_cwd=$no_cwd (suffix=$suffix)"

  if [ "$do_lock" = "1" ] && [ "$reopened" -gt 0 ]; then
    sleep 3
    loginctl lock-session 2>/dev/null \
      || dbus-send --session --type=method_call --dest=org.gnome.ScreenSaver \
           /org/gnome/ScreenSaver org.gnome.ScreenSaver.Lock 2>/dev/null
    echo "guard: ekran kilitlendi"
  fi
}

# ─────────────────────────────────────────────
# help
# ─────────────────────────────────────────────
cmd_help() {
  cat <<'HELP'
claudeops — açık Claude CLI session'ları toplu yönet
   (Bu konuşma her zaman korunur — find_self_claude_pid via $$ ata zinciri)

KULLANIM:
  claudeops self
      Bu konuşmanın pid, sessionId, bridge URL'ini göster.

  claudeops list [all|all-but-self|<name>...]
      Açık session'ları tablo olarak listele.

  claudeops kill <all-but-self|<name>...>
      Hedef(ler)e SIGTERM. 10s grace, sonra ölmüş mü kontrol.

  claudeops compact <all-but-self|<name>...> [--backup]
      Her hedefe `claude --resume <sid> -p "/compact" < /dev/null`.
      Başarı: jsonl'da isCompactSummary marker'ı +1 artarsa.
      Rate-limit'te otomatik durur. --backup ile önce jsonl yedeği.

  claudeops rc <all-but-self|<name>...> [--detached|--visible] [--kill-first]
      RC ile yeniden aç.
        --visible (default): gnome-terminal penceresinde, görünür
        --detached: script -qfc ile arkaplan pty, görünmez
        --kill-first: önce mevcut pid'i SIGTERM, sonra aç

  claudeops send <name1[,nameN]> -- "prompt metni"
      Hedef(ler)e -p ile prompt gönder. user/assistant turu eklenir.
      Slash command da olabilir: `claudeops send all-but-self -- "/clear"`

  claudeops batch <all-but-self>
      Tam pipeline: backup → kill → compact → rc (visible). 14 session için
      ~30-50dk + token harcaması. Rate-limit'te compact aşamasında durur.

  claudeops desktops [N]
      GNOME workspace sayısını sabit N olarak ayarla (dynamic-workspaces=off).
      N verilmezse mevcut değeri gösterir. gsettings ile, install gerektirmez.

  claudeops layout [grid] [N] [--per=4] [--pin=<n1,n2,...>] [--group=<b1,b2,...>]
      Pencereleri 2×2 grid yerleştir, her workspace'e <per> tane (default 4).
      --pin=carla13,hcr13,...  bu isimler desktop 0'a; geri kalanı ws 1..N'e.
      --group=hc,hcr,mecdtfl  bu session'lar (base-name eşleşme, suffix stripli →
        handover'da 29→30 değişse de tutar) others'tan SONRA kendi taze desktop'una
        blok halinde yerleşir; asla bölünmez. Tekrarlanabilir (çok grup).
      İhtiyaç: wmctrl. Yetersiz workspace varsa ekrana mesaj yazar (claudeops
      desktops <N> ile arttır).

  claudeops new <name> [cwd]
      Yeni (boş) Claude session başlat. RC aktif, görünür gnome-terminal.
      cwd verilmezse mevcut PWD.

  claudeops cleanup [--dry-run]
      Orphan gnome-terminal pencerelerini (bash-prompt'a düşmüş, claude yok)
      kapat. Self bash hariç tutulur. --dry-run ile sadece listele.

  claudeops cancel <all-but-self|name...>
      RC'yi bloklayan modal'a (permission/model/trust dialog) Esc gönderir.
      Görünür yapıp activate + Esc. İnmezse (VTE reject) rc --kill-first öner.

  claudeops compact ... --visible
      Compact'i gnome-terminal penceresinde aç (canlı output görünür).
      Pencere işlem bittikten 3s sonra kapanır.

  claudeops migrate <session> --to=<new-cwd> [--files=p1,p2,...] [--gh] [--glab]
                                              [--no-respawn] [--no-trust-patch] [--dry-run]
      Bir session'ın cwd'sini taşı. Auto-discover: old_cwd/CLAUDE.md içindeki
      ~/X.md ve ./X.md referansları (eski cwd'de var olanlar). Ekstralar --files
      ile (virgül-ayrılı, absolute veya old_cwd-relative). Yapılan işler:
        1) Dosyaları new_cwd/'e mv
        2) ~/.claude/projects/<old-encoded>/ → <new-encoded>/ mv (memory + jsonl)
        3) Taşınan md + memory md'lerinde "~/X.md" → "./X.md" path rewrite
        4) .claude.json trust patch (--no-trust-patch ile atla)
        5) --gh/--glab: git init + repo create + remote + first commit + push
        6) Eski pid'i kill, new_cwd'de aynı model/perm/RC name ile fresh spawn

  claudeops boot [--lock] [--layout] [--from-roster] [--pace=N]
      Cold-boot oto-açılış (autologin + ~/.config/autostart/claudeops.desktop ile
      reboot'ta otomatik). Default kaynak ~/.claude/claudeops/boot.list (co + mo).
      Her session'ı base-name + SON SUFFIX ile (co30) ve cwd'sinin EN GÜNCEL
      transcript'iyle --resume ederek açar (geçmiş korunur). --lock: en son ekranı
      kilitler (fleet arkada çalışır, şifreyle aç). Suffix: ~/.claude/claudeops/suffix
      (rc --suffix=N ile oto-güncellenir). --from-roster: snapshot'tan tam fleet.

  claudeops guard [--boot] [--lock] [--dry-run] [--pace=N]
      Watchdog: models.tsv fleet'ini tara, kapananları yeniden aç (models.tsv→model,
      roster.tsv→cwd, suffix state). Zaten çalışan session'ları atlar; kapananları
      --resume <en-güncel-sid> ile gnome-terminal'de yeniden açar.
      --boot: X/WM hazır olana dek 90s bekle (autostart/reboot için).
      --lock: spawn sonrası ekranı kilitle. --dry-run: ne açılacağını göster.
      Cron: */2 * * * * DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus claudeops guard

  claudeops snapshot
      Canlı fleet'i ~/.claude/claudeops/roster.tsv'ye dök (name⇥cwd⇥model). self hariç.
      guard/boot --from-roster için referans. Fleet ayaktayken bir kez çalıştır.

  claudeops recover [--since=ISO]
      READ-ONLY: reboot sonrası resume-edilebilir session'lar. jsonl transcript'ler
      reboot'tan sağ çıkar → her repo'nun en güncel'i: cwd · sid · git-dirty · son-aktif.
      Resume: cd <cwd> && claude --resume <sid>  (ya da boot otomatik yapar).

  claudeops needs-ho [--from-suffix=N] [--baseline=ISO] [--no-fetch]
      READ-ONLY: hangi session'lar handover (wrap-up) gerektiriyor? 6 sinyal tablosu:
      modified/staged/untracked (working tree) · unpushed (tüm remote'lar) · jsonl ·
      since? (son commit, baseline=son-handover'dan yeni mi). Sinyallerden BİRİ → HO.
      KRİTİK: commit-since sinyali, commit'lenip push'lanmış ama jsonl'siz (compaction)
      session'ları yakalar — repo_dirty+jsonl tek başına bunları "idle-clean" sanıp
      ATLIYORDU. Baseline state: ~/.claude/claudeops/last-handover.ts (her ho'da güncellenir).

  claudeops handover [--from-suffix=13] [--to-suffix=14] [--dry-run]
                     [--skip-msg] [--message=...] [--message-file=path]
                     [--force] [--timeout=1800]
      --force: skip kontrollerini (already-done / idle-only / dirty) baypas et,
        HEPSİNE wrap-up gönder. jsonl olmayanı fresh-spawn (model/perm cmdline'dan)
        ile açar. Default'ta skip mantığı geçerli (sadece gerekenlere gönderir).
      --layout [--pin=a,b]: tüm wrap-up pencereleri açıldıktan sonra otomatik
        'layout grid 4' çalıştır (Faz 1 + tile tek komutta).
      Her <name><from> session için:
        0) BUSY ise idle olana kadar bekler (max 60dk)
        1) Wrap-up mesajı gönderir (Claude commit/push + MD update yapsın diye)
           Default mesaj:
             "kaldigimiz yeri kaydedelim. yeni session da devam ederiz.
              konusup ve bulup ve arastirip da not almadigimiz kaldi mi?
              her sey commit ve push lu mu? todo/changelog/claude.md guncel mi?
              Yeni sessiona hazir miyiz? Bulduklarimizdan kayit altina almadigimiz kaldi mi?"
        2) <name><from> session'ı kill
        3) Yerine <name><to> FRESH session (RC + gnome-terminal visible) açar
      Rate-limit'te otomatik durur. Açık session sayısı runtime'da discover edilir.
      Token-pahalı: 14 session × ~5-30dk = ~1-7 saat + büyük token harcaması.

  claudeops help
      Bu metni göster.

HEDEF SYNTAX:
  all              — tüm session'lar (self DAHİL — dikkat!)
  all-but-self     — self hariç hepsi (TAVSİYE EDİLEN)
  <name1> <name2>  — TSV name alanına göre eşleş (self otomatik hariç)

NOTLAR:
  - Compact başarı kanıtı: ~/.claude/projects/<dir>/<sid>.jsonl içinde
    `"isCompactSummary":true` marker'ı +1 artmalı.
  - Bridge URL: https://claude.ai/code/<bridgeSessionId>
  - Backup: <sid>.jsonl.bak.YYYYMMDD-HHMMSS yan-yana yazılır.
  - Log: /tmp/claudeops/compact.log
HELP
}

# ─────────────────────────────────────────────
# Dispatcher
# ─────────────────────────────────────────────
case "${1:-help}" in
  help|--help|-h) cmd_help ;;
  self) cmd_self ;;
  list) shift; cmd_list "$@" ;;
  kill) shift; cmd_kill "$@" ;;
  compact) shift; cmd_compact "$@" ;;
  rc) shift; cmd_rc "$@" ;;
  send) shift; cmd_send "$@" ;;
  batch) shift; cmd_batch "$@" ;;
  desktops|workspaces) shift; cmd_desktops "$@" ;;
  layout) shift; cmd_layout "$@" ;;
  new) shift; cmd_new "$@" ;;
  cleanup) shift; cmd_cleanup "$@" ;;
  cancel) shift; cmd_cancel "$@" ;;
  handover) shift; cmd_handover "$@" ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  boot) shift; cmd_boot "$@" ;;
  guard) shift; cmd_guard "$@" ;;
  recover) shift; cmd_recover "$@" ;;
  needs-ho|needsho|needs_ho) shift; cmd_needs_ho "$@" ;;
  stamp-baseline|baseline) shift; cmd_stamp_baseline "$@" ;;
  migrate) shift; cmd_migrate "$@" ;;
  *) echo "Bilinmeyen komut: $1"; cmd_help; exit 2 ;;
esac
